# Google Gemini API Key (https://aistudio.google.com/ 에서 무료 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 국가법령정보 공동활용 Open API (https://open.law.go.kr/ 무료 회원가입 후 즉시 발급)
# ※ 1단계에서 수동 샘플로 테스트할 경우 당장 없어도 무방합니다.
LAW_API_KEY=your_law_api_key_here

# 기본 LLM 프로바이더 (gemini 또는 ollama)
LLM_PROVIDER=gemini

# 로컬 임베딩 모델명 (HuggingFace)
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 로컬 벡터 저장소 경로
CHROMA_PERSIST_DIR=./data/chroma_db
